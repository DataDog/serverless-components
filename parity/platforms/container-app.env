# Azure Container Apps. CONTAINER_APP_NAME makes serverless-init detect Container Apps; the revision
# and replica names give their tags, and the region is the third-from-last label of the
# environment's DNS suffix. Azure sets these four. DD_AZURE_SUBSCRIPTION_ID and
# DD_AZURE_RESOURCE_GROUP are set by the user, and serverless-init stops without them when an API
# key is set. The IDs are fake. Every value is fixed, so nothing needs masking.
CONTAINER_APP_NAME=parity-app
CONTAINER_APP_REVISION=parity-app--0000001
CONTAINER_APP_REPLICA_NAME=parity-app--0000001-6b8f9c7d5-x2k4q
CONTAINER_APP_ENV_DNS_SUFFIX=parity-environment.eastus.azurecontainerapps.io
DD_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
DD_AZURE_RESOURCE_GROUP=parity-resource-group
