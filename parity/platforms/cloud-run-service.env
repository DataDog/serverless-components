# Google Cloud Run services. K_SERVICE makes serverless-init detect a Cloud Run service; K_REVISION
# and K_CONFIGURATION give the revision and configuration tags. Cloud Run also sets PORT. The
# harness runs the fake metadata server as metadata.google.internal for every cloud-run-* platform,
# which answers the instance ID, region and project (internal/gcpmetadata).
K_SERVICE=parity-service
K_REVISION=parity-service-00001-abc
K_CONFIGURATION=parity-service
PORT=8080
