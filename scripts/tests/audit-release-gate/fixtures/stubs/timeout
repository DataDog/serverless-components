#!/usr/bin/env bash
#
# Test double for coreutils timeout used by the audit release gate tests.
#
# By default (FAKE_TIMEOUT_MODE=exec) it delegates to the real timeout binary so
# the gate's bounded scanner invocation behaves exactly as in production.
# FAKE_TIMEOUT_MODE=fail124 and fail137 simulate a scan killed by the timeout
# (SIGTERM and SIGKILL respectively) without waiting for the real 5 minute bound.
# FAKE_TIMEOUT_RECORD captures the full argument list so tests can assert the
# reviewed --kill-after and duration bounds are present.
set -euo pipefail

if [ -n "${FAKE_TIMEOUT_RECORD:-}" ]; then
  printf '%s\n' "$*" >>"$FAKE_TIMEOUT_RECORD"
fi

case "${FAKE_TIMEOUT_MODE:-exec}" in
  exec)
    exec "${REAL_TIMEOUT:?REAL_TIMEOUT must point at the real timeout}" "$@"
    ;;
  fail124)
    printf 'timeout stub: simulated scanner timeout (SIGTERM)\n' >&2
    exit 124
    ;;
  fail137)
    printf 'timeout stub: simulated scanner kill (SIGKILL)\n' >&2
    exit 137
    ;;
  *)
    printf 'timeout stub: unknown FAKE_TIMEOUT_MODE\n' >&2
    exit 64
    ;;
esac
