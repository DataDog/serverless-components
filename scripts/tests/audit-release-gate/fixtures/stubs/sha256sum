#!/usr/bin/env bash
#
# Test double for sha256sum used by the audit release gate tests.
#
# The gate hashes real files (the repository lockfile and policy) and the
# downloaded scanner archive. Real hashing is delegated to $REAL_SHA256SUM so the
# source/lockfile identity checks are genuinely exercised. Only the fixture
# archive, identified by its real digest, is substituted with the reviewed pin
# (FAKE_ARCHIVE_SHA_MODE=ok) or with a wrong digest (FAKE_ARCHIVE_SHA_MODE=bad).
set -euo pipefail

if [ "$#" -ge 1 ] && [ -f "$1" ]; then
  actual="$("${REAL_SHA256SUM:?REAL_SHA256SUM must point at the real sha256sum}" "$1" | cut -d' ' -f1)"
  if [ -n "${FAKE_ARCHIVE_REAL_SHA:-}" ] && [ "$actual" = "$FAKE_ARCHIVE_REAL_SHA" ]; then
    case "${FAKE_ARCHIVE_SHA_MODE:-ok}" in
      ok) printf '%s  %s\n' "${FAKE_ARCHIVE_SHA:?FAKE_ARCHIVE_SHA must be set}" "$1" ;;
      bad) printf '%064d  %s\n' 0 "$1" ;;
      *) printf 'sha256sum stub: unknown FAKE_ARCHIVE_SHA_MODE\n' >&2; exit 64 ;;
    esac
    exit 0
  fi
fi

exec "${REAL_SHA256SUM:?REAL_SHA256SUM must point at the real sha256sum}" "$@"
